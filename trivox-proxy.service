[Unit]
Description=TriVox Memory Proxy v4
After=network.target qdrant.service ollama.service
Wants=qdrant.service ollama.service

[Service]
Type=simple
User=aque
WorkingDirectory=/home/aque/memory-proxy-v4
Environment=MODEL_PATH=/home/aque/trivox2_step120000.pt
Environment=TOK_FR=/home/aque/trivox-memory-v3/tokenizers/fr.model
Environment=TOK_EN=/home/aque/trivox-memory-v3/tokenizers/en.model
Environment=TOK_CODE=/home/aque/trivox-memory-v3/tokenizers/code.json
Environment=OLLAMA_URL=http://localhost:11434
ExecStart=/usr/bin/python3 /home/aque/memory-proxy-v4/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
